{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meine-geschichte-als-lied",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meine-geschichte-als-lied-db",
      "database_id": "18db61e3-7bd7-44d3-b894-4d9ec7b13003"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "meine-geschichte-als-lied-media"
    }
  ]
}
