{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mon-histoire-chantee",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mon-histoire-chantee-db",
      "database_id": "06586181-7888-4ca1-86b8-c3ae60c90da2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mon-histoire-chantee-media"
    }
  ],
  "vars": {
    "SHOPIFY_STORE_DOMAIN": "monhistoirechantee.myshopify.com",
    "SHOPIFY_API_VERSION": "2026-04"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "contact@monhistoirechantee.com"
      ]
    }
  ]
}
